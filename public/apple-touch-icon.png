<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="50%" stop-color="#D97706" />
      <stop offset="100%" stop-color="#78350F" />
    </linearGradient>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E1E24" />
      <stop offset="100%" stop-color="#0A0A0C" />
    </linearGradient>
    <linearGradient id="heartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F43F5E" />
      <stop offset="100%" stop-color="#BE123C" />
    </linearGradient>
  </defs>
  
  <!-- Outer Frame Background with Safe Margin -->
  <rect width="512" height="512" rx="100" fill="url(#bgGrad)" />
  
  <!-- Realistic Golden Wooden Frame Border -->
  <rect x="56" y="56" width="400" height="400" rx="36" fill="none" stroke="url(#goldGrad)" stroke-width="24" />
  <rect x="80" y="80" width="352" height="352" rx="20" fill="#18181B" stroke="#FBBF24" stroke-width="4" stroke-opacity="0.3" />
  
  <!-- Inner Picture Matte Canvas -->
  <rect x="104" y="104" width="304" height="304" rx="12" fill="#27272A" />

  <!-- Mountain Landscape & Sun Artwork -->
  <circle cx="180" cy="180" r="32" fill="#FBBF24" />
  <path d="M120 370 L220 250 L290 320 L330 270 L392 370 Z" fill="#3F3F46" />
  <path d="M180 370 L250 280 L310 370 Z" fill="#52525B" opacity="0.8" />

  <!-- Heart Badge in Golden Frame -->
  <g transform="translate(320, 150) scale(1.4)">
    <circle cx="16" cy="16" r="22" fill="#18181B" stroke="url(#goldGrad)" stroke-width="3" />
    <path d="M16 23.5 C16 23.5 8 18 8 13 C8 10 10.5 8 13 8 C14.5 8 15.5 8.8 16 10 C16.5 8.8 17.5 8 19 8 C21.5 8 24 10 24 13 C24 18 16 23.5 16 23.5 Z" fill="url(#heartGrad)" />
  </g>
</svg>
